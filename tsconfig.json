{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "obsidian": ["node_modules/obsidian"] },
    "typeRoots": ["node_modules/@types", "node_modules/obsidian"],
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "CommonJS",
    "target": "es6",
    "allowJs": false,
    "noImplicitAny": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "outDir": "dist",
    "declaration": false,
    "moduleResolution": "node",
    "importHelpers": false,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "lib": ["dom", "es5", "scripthost", "es2015", "es2016", "es2017", "es2018", "es2019", "es2020", "es2021"]
  },
  "include": ["src/**/*.ts"]
}
